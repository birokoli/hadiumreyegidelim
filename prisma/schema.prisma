generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  id        String   @id @default(cuid())
  pax       Int
  totalUSD  Float
  status    String   @default("PENDING")

  flight    String?  // JSON string
  hotel     String?  // JSON string
  transfer  String?  // JSON string
  guide     String?  // JSON string
  extras    String?  // JSON string

  contactInfo String? // JSON string: name, email, phone

  user        User?    @relation(fields: [userId], references: [id])
  userId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  type        String   // FLIGHT, HOTEL, TRANSFER, EXTRA
  name        String
  description String?
  price       Float
  extraData   String?  // JSON for additional info
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Guide {
  id             String   @id @default(cuid())
  slug           String?  @unique
  name           String
  title          String
  price          Float
  image          String?
  biography      String?
  quote          String?
  youtubeUrl     String?
  expertise      String?
  publications   String?
  linkedPackages String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Author {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  image     String?
  expertise String?
  linkedin  String?
  twitter   String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  metaTitle   String?
  description String?
  content     String
  keywords    String?
  tags        String?
  author      String   @default("Admin")
  authorId    String?
  authorModel Author?  @relation(fields: [authorId], references: [id])
  imageUrl    String?
  imageAlt    String?
  tldr        String?
  faq         String?
  published   Boolean  @default(false)
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  focusKeyword String?
  seoScore    Int?
  personalExperience String?
  references  String?
  imagePrompts String?
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Package {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  price       Float
  currency    String   @default("USD")
  duration    String
  imageUrl    String?
  gallery     String?
  includes    String?
  isPopular   Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Hotel {
  id             String   @id @default(cuid())
  name           String
  city           String   @default("Mekke (Makkah)")
  price          Float
  stars          Int      @default(5)
  distanceMeters Int      @default(100)
  distanceText   String
  description    String?
  images         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AILog {
  id          String   @id @default(cuid())
  topic       String?
  status      String   @default("STARTING")
  details     String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  package   String?
  message   String?
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostVersion {
  id          String   @id @default(cuid())
  postId      String
  title       String
  content     String
  description String?
  version     Int
  savedBy     String?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// INFLUENCER MARKETING SİSTEMİ
// ─────────────────────────────────────────────────────────

model Influencer {
  id              String   @id @default(cuid())
  // Kişisel
  fullName        String
  email           String   @unique
  password        String
  phone           String
  tcNo            String?
  birthDate       String?
  avatarUrl       String?
  // Sosyal medya
  instagramHandle String?
  instagramFollowers Int?  @default(0)
  tiktokHandle    String?
  youtubeHandle   String?
  // Sistem
  tier            String   @default("davetci")  // eci | rehber | davetci
  uniqueCode      String   @unique              // Kupon kodu: AHMETHOCA100
  uniqueUrl       String   @unique              // /r/ahmethoca
  status          String   @default("pending")  // pending | active | passive | rejected
  rejectReason    String?
  // Ödeme
  bankIban        String?
  bankName        String?
  bankAccountName String?
  // İstatistik (cache)
  totalSales      Int      @default(0)
  totalEarnings   Float    @default(0)
  pendingEarnings Float    @default(0)
  totalClicks     Int      @default(0)
  // Affiliate
  programUnlocked Boolean  @default(false)
  baseThrOverride Int?
  unlockedAt      DateTime?
  firstShareAt    DateTime?
  // İlişkiler
  shares          Share[]
  customers       Customer[]
  sales           Sale[]
  payments        Payment[]
  linkClicks      LinkClick[]
  campaigns       CampaignParticipant[]
  loyaltyAccount  LoyaltyAccount?
  supportChat     SupportChat?
  starLedgerEntries  StarLedger[]
  perfScores         PerformanceScore[]
  perfEvents         PerformanceEvent[]
  referralsMade      Referral[]         @relation("ReferrerRelation")
  referralReceived   Referral?          @relation("InvitedRelation")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SupportChat {
  id                  String           @id @default(cuid())
  influencer          Influencer       @relation(fields: [influencerId], references: [id])
  influencerId        String           @unique
  status              String           @default("open") // open | closed
  lastMessageAt       DateTime         @default(now())
  unreadByAdmin       Int              @default(0)
  unreadByInfluencer  Int              @default(0)
  createdAt           DateTime         @default(now())
  messages            SupportMessage[]
}

model SupportMessage {
  id         String      @id @default(cuid())
  chat       SupportChat @relation(fields: [chatId], references: [id])
  chatId     String
  senderType String      // "influencer" | "admin"
  content    String
  createdAt  DateTime    @default(now())
}

model Share {
  id              String   @id @default(cuid())
  influencer      Influencer @relation(fields: [influencerId], references: [id])
  influencerId    String
  platform        String   // instagram_story | instagram_reel | instagram_post | tiktok | youtube | x | other
  shareUrl        String?
  screenshotUrl   String?
  shareDate       String
  description     String?
  status          String   @default("pending")  // pending | approved | rejected
  rejectReason    String?
  viewCount       Int      @default(0)
  clickCount      Int      @default(0)
  saleCount       Int      @default(0)
  approvedAt      DateTime?
  approvedBy      String?  // admin id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  linkClicks      LinkClick[]
}

model Customer {
  id              String   @id @default(cuid())
  fullName        String
  phone           String
  email           String?
  tcNo            String?
  source          String   @default("link")  // link | coupon | manual_phone | manual_branch
  influencer      Influencer? @relation(fields: [influencerId], references: [id])
  influencerId    String?
  referrerUrl     String?
  couponUsed      String?
  firstSeenAt     DateTime @default(now())
  status          String   @default("clicked")  // clicked | contacted | in_discussion | contracted | paid | completed | cancelled
  assignedOperatorId String?
  notes           String?
  sales           Sale[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Sale {
  id               String   @id @default(cuid())
  customer         Customer @relation(fields: [customerId], references: [id])
  customerId       String
  influencer       Influencer? @relation(fields: [influencerId], references: [id])
  influencerId     String?
  umrePackage      String?
  saleAmount       Float
  commissionRate   Float    @default(0.05)
  commissionAmount Float
  commissionStatus String   @default("pending")  // pending | earned | paid | refunded
  affiliatePeriod  String?  // "YYYY-MM-01" — komisyon dönemine bağlama
  saleDate         DateTime @default(now())
  completionDate   DateTime?
  refundDeadline   DateTime?
  notes            String?
  // Loyalty fields
  lockedCommissionRate    Float?
  pointsEarned            Int      @default(0)
  monthlyTierAtSale       String?
  monthlyMultiplierAtSale Float?
  monthlySaleNumberAtSale Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payments         PaymentSale[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Payment {
  id            String   @id @default(cuid())
  influencer    Influencer @relation(fields: [influencerId], references: [id])
  influencerId  String
  periodMonth   String   // "2026-01"
  totalAmount   Float
  taxDeduction  Float    @default(0)
  netAmount     Float
  status        String   @default("pending")  // pending | approved | paid | cancelled
  approvedBy    String?
  approvedAt    DateTime?
  paidAt        DateTime?
  bankReference String?
  notes         String?
  sales         PaymentSale[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentSale {
  payment   Payment @relation(fields: [paymentId], references: [id])
  paymentId String
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String
  @@id([paymentId, saleId])
}

// ─────────────────────────────────────────────────────────
// LOYALTY / YILDIZ SİSTEMİ
// ─────────────────────────────────────────────────────────

model LoyaltyAccount {
  id                     String   @id @default(cuid())
  influencer             Influencer @relation(fields: [influencerId], references: [id])
  influencerId           String   @unique
  currentBalance         Int      @default(0)
  lifetimeEarned         Int      @default(0)
  lifetimeRedeemed       Int      @default(0)
  // Aylık tier
  currentMonthSalesCount Int      @default(0)
  currentMonthYear       Int
  currentMonthNumber     Int
  currentMonthlyTier     String   @default("baslangic")
  // Yıllık onur tier
  currentYear            Int
  yearlySalesCount       Int      @default(0)
  currentHonorTier       String   @default("yolcu")
  // Puan süresi
  lastActivityAt         DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  transactions           LoyaltyTransaction[]
  redemptions            LoyaltyRedemption[]
  monthlyHistory         LoyaltyMonthlyHistory[]
}

model LoyaltyTransaction {
  id                   String   @id @default(cuid())
  account              LoyaltyAccount @relation(fields: [accountId], references: [id])
  accountId            String
  transactionType      String   // earn | redeem | refund | expire | adjust | yearly_bonus
  pointsAmount         Int      // pozitif veya negatif
  cashEquivalent       Float
  // Kazanım detayları
  sourceSale           Sale?    @relation(fields: [sourceSaleId], references: [id])
  sourceSaleId         String?
  basePoints           Int?
  multiplierApplied    Float?
  tierAtEarn           String?
  monthlySaleNumber    Int?
  // Harcama detayları
  redemption           LoyaltyRedemption? @relation(fields: [redemptionId], references: [id])
  redemptionId         String?
  description          String?
  metadata             String?  // JSON
  isReversed           Boolean  @default(false)
  reversedByTxId       String?
  createdAt            DateTime @default(now())

  @@index([accountId])
  @@index([transactionType])
  @@index([sourceSaleId])
}

model LoyaltyRedemption {
  id                  String   @id @default(cuid())
  account             LoyaltyAccount @relation(fields: [accountId], references: [id])
  accountId           String
  redemptionType      String   // cash | free_umrah | hybrid_umrah | gift_item | customer_discount
  pointsUsed          Int
  cashValue           Float
  // Hedef kişi
  targetUser          String?  // self | es | anne | baba | kardes | cocuk
  targetFullName      String?
  targetTcNo          String?
  targetPhone         String?
  // Umre
  umrePackageName     String?
  // Katalog
  catalogItem         LoyaltyCatalogItem? @relation(fields: [catalogItemId], references: [id])
  catalogItemId       String?
  // Nakit
  bankIban            String?
  // Müşteri indirimi
  discountCouponCode  String?
  discountAmount      Float?
  expiresAt           DateTime?
  // Karma
  hybridCustomerPayment Float?
  // Durum
  status              String   @default("pending")  // pending | approved | completed | rejected | cancelled
  rejectionReason     String?
  requestedAt         DateTime @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?
  completedAt         DateTime?
  notes               String?
  transactions        LoyaltyTransaction[]
}

model LoyaltyCatalogItem {
  id                  String   @id @default(cuid())
  sku                 String   @unique
  name                String
  description         String?
  imageUrl            String?
  pointsRequired      Int
  cashEquivalent      Float
  stockQuantity       Int?
  isActive            Boolean  @default(true)
  category            String   // hediye_ceki | otel | yemek | deneyim | paket
  requiresAdminAction Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  redemptions         LoyaltyRedemption[]
}

model LoyaltyMonthlyHistory {
  id               String   @id @default(cuid())
  account          LoyaltyAccount @relation(fields: [accountId], references: [id])
  accountId        String
  year             Int
  month            Int
  totalSales       Int      @default(0)
  totalPointsEarned Int     @default(0)
  maxTierReached   String?
  archivedAt       DateTime @default(now())

  @@unique([accountId, year, month])
}

model LoyaltyMonthlyTierRule {
  id           String   @id @default(cuid())
  tierName     String   @unique  // baslangic | hizli | uretken | sampiyon
  minMonthlySales Int
  multiplier   Float
  colorHex     String?
  displayOrder Int      @default(0)
}

model LoyaltyHonorTierRule {
  id                 String   @id @default(cuid())
  tierName           String   @unique  // yolcu | haci_adayi | haci | veli
  minYearlySales     Int
  yearEndBonusPoints Int      @default(0)
  perksDescription   String?
  colorHex           String?
  displayOrder       Int      @default(0)
}

model LinkClick {
  id           String   @id @default(cuid())
  influencer   Influencer @relation(fields: [influencerId], references: [id])
  influencerId String
  share        Share?   @relation(fields: [shareId], references: [id])
  shareId      String?
  ipAddress    String?
  userAgent    String?
  referrer     String?
  country      String?
  utmSource    String?
  utmContent   String?
  isBot        Boolean  @default(false)
  clickedAt    DateTime @default(now())
}

model AttributionOverride {
  id              String   @id @default(cuid())
  customerId      String
  oldInfluencerId String?
  newInfluencerId String?
  reason          String?
  overriddenBy    String   // admin id
  overriddenAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// KAMPANYA SİSTEMİ
// ─────────────────────────────────────────────────────────

model Campaign {
  id              String   @id @default(cuid())
  title           String                        // "Transfer %10 İndirim"
  slug            String   @unique              // "transfer-10"
  description     String?
  type            String                        // package | transfer | hotel | flight | all
  discountType    String   @default("percent")  // percent | fixed
  discountValue   Float                         // 10 = %10 veya 500 = 500TL sabit
  codeTemplate    String                        // "Transfer10" → koda eklenir → "YasinTransfer10"
  status          String   @default("active")   // active | paused | ended
  startDate       DateTime?
  endDate         DateTime?
  maxParticipants Int?                          // null = sınırsız
  imageUrl        String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  participants    CampaignParticipant[]
  codeUsages      CampaignCodeUsage[]
}

model CampaignParticipant {
  id             String   @id @default(cuid())
  campaign       Campaign   @relation(fields: [campaignId], references: [id])
  campaignId     String
  influencer     Influencer @relation(fields: [influencerId], references: [id])
  influencerId   String
  uniqueCode     String   @unique  // "YasinTransfer10"
  joinedAt       DateTime @default(now())
  usageCount     Int      @default(0)
  @@unique([campaignId, influencerId])
  codeUsages     CampaignCodeUsage[]
}

model CampaignCodeUsage {
  id              String   @id @default(cuid())
  campaign        Campaign  @relation(fields: [campaignId], references: [id])
  campaignId      String
  participant     CampaignParticipant @relation(fields: [participantId], references: [id])
  participantId   String
  customerName    String?
  customerPhone   String?
  note            String?
  usedAt          DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// FİYAT TEKLİFİ SİSTEMİ
// ─────────────────────────────────────────────────────────

model CompanySettings {
  id             String   @id @default(cuid())
  logoPath       String?  // public/ altında saklanan dosya yolu
  defaultMargin  Float    @default(18)
  defaultUsdRate Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Quotation {
  id             String          @id @default(cuid())
  quotationNo    String          @unique  // "TKF-2026-0001"
  customerName   String
  customerPhone  String?
  customerEmail  String?
  adultsCount    Int             @default(1)
  childrenCount  Int             @default(0)
  travelDate     String?         // "8-13 Haziran 2026" — PDF başlığı
  startDate      String?         // "8 Haziran 2026" — PDF meta satırı
  validUntil     String?         // "3 iş günü" gibi serbest metin
  margin         Float           @default(18)  // % kar marjı — PDF'e yansımaz
  usdRate        Float           @default(0)   // USD/TRY kuru
  status         String          @default("draft")  // draft | sent | accepted | rejected | expired
  notes          String?         // sadece admin görür
  items          QuotationItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// pricingType değerleri:
//   per_person  — vize, tren, bilet (kişi başı × yetişkin + çocuk × childPricePercent)
//   per_vehicle — transfer, araçlı tur (birim × adet araç)
//   per_room    — otel (oda fiyatı × oda adedi + extraBedPriceUsd × extraBedCount)
//   flat        — tek seferlik sabit fiyat × adet
model QuotationItem {
  id                String    @id @default(cuid())
  quotation         Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId       String
  category          String    // vize | hotel | transfer | tur | flight | extra
  name              String
  description       String?
  pricingType       String    @default("flat")  // per_person | per_vehicle | per_room | flat
  unitCostUsd       Float     @default(0)       // birim alış fiyatı (USD)
  quantity          Int       @default(1)        // araç adedi / oda sayısı / adet
  childPricePercent Float     @default(0)        // per_person: çocuk kalem oranı (0-100)
  vehicleType       String?                      // per_vehicle: sedan|minivan|gmc|midibus|bus
  extraBedCount     Int       @default(0)        // per_room: ek yatak sayısı
  extraBedPriceUsd  Float     @default(0)        // per_room: ek yatak birim alış
  saleTotalUsd      Float     @default(0)        // hesaplanan satış toplamı (margin dahil)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
}

model ServiceLibrary {
  id                   String   @id @default(cuid())
  category             String   // vize | hotel | transfer | tur | flight | extra
  name                 String
  description          String?
  defaultPricingType   String   @default("flat")  // per_person | per_vehicle | per_room | flat
  defaultCostUsd       Float    @default(0)
  defaultVehicleType   String?
  defaultChildPercent  Float    @default(0)
  defaultExtraBedPrice Float    @default(0)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// AFFİLİATE SİSTEMİ
// ─────────────────────────────────────────────────────────

model ProgramConfig {
  id                Int      @id @default(1)
  baseThreshold     Int      @default(20)    // Program açılış eşiği (geçerli satış)
  minThreshold      Int      @default(5)     // Referral indirimi sonrası minimum eşik
  referralReduction Int      @default(3)     // Davet başına düşülen eşik miktarı
  startRate         Float    @default(3.0)   // Başlangıç komisyon oranı (%)
  maxRate           Float    @default(7.0)   // Maksimum komisyon oranı (%)
  starToTry         Float    @default(0.10)  // 1 yıldız = kaç TL
  weightCvr         Float    @default(0.40)  // Skor ağırlıkları
  weightVolume      Float    @default(0.40)
  weightCtr         Float    @default(0.20)
  updatedAt         DateTime @updatedAt
}

model StarLedger {
  id           String    @id @default(cuid())
  influencer   Influencer @relation(fields: [influencerId], references: [id])
  influencerId String
  delta        Float     // Pozitif: kazanç, Negatif: harcama
  reason       String    // commission | admin_adjust | withdraw | gift_redeem | referral_bonus | reversal
  note         String?
  createdBy    String    @default("system")
  refSaleId    String?   // ilgili satış ID'si (komisyon kaydında)
  createdAt    DateTime  @default(now())

  @@index([influencerId])
}

model PerformanceScore {
  id            String   @id @default(cuid())
  influencer    Influencer @relation(fields: [influencerId], references: [id])
  influencerId  String
  period        String   // "YYYY-MM-01"
  ctr           Float    @default(0)
  cvr           Float    @default(0)
  volume        Int      @default(0)
  ctrNorm       Float    @default(0)
  cvrNorm       Float    @default(0)
  volumeNorm    Float    @default(0)
  score         Float    @default(0)
  commissionRate Float   @default(3.0)
  computedAt    DateTime @default(now())

  @@unique([influencerId, period])
  @@index([influencerId])
}

model PerformanceEvent {
  id           String   @id @default(cuid())
  influencer   Influencer @relation(fields: [influencerId], references: [id])
  influencerId String
  period       String   // "YYYY-MM-01"
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([influencerId, period])
  @@index([influencerId])
}

model Referral {
  id               String    @id @default(cuid())
  referrer         Influencer @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referrerId       String
  invited          Influencer @relation("InvitedRelation", fields: [invitedId], references: [id])
  invitedId        String    @unique  // Bir kişi sadece 1 davetten gelir
  qualified        Boolean   @default(false)
  qualifiedAt      DateTime?
  qualifiedPeriod  String?
  reductionApplied Int?
  createdAt        DateTime  @default(now())
  qualifications   ReferralQualification[]

  @@index([referrerId])
}

model ReferralQualification {
  id          String   @id @default(cuid())
  referral    Referral @relation(fields: [referralId], references: [id])
  referralId  String
  referrerId  String   // Denormalized for fast query
  period      String
  reduction   Int
  createdAt   DateTime @default(now())

  @@unique([referralId, period])
  @@index([referrerId, period])
}
